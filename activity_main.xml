<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MicEQ Pro"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#00E676"/>

            <Switch
                android:id="@+id/swPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ON"
                android:textColor="#FFFFFF"
                android:thumbTint="#00E676"
                android:trackTint="#444444"/>
        </LinearLayout>

        <!-- ── VU Meter ───────────────────────────────────────────────── -->
        <LinearLayout
            style="@style/CardBox"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="INPUT LEVEL"
                    android:textColor="#888888" android:textSize="11sp" android:textAllCaps="true"/>
                <TextView android:id="@+id/tvVuDb" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="-∞ dB"
                    android:textColor="#00E676" android:textSize="12sp"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbVu"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:progressTint="#00E676"
                android:progressBackgroundTint="#2A2A2A"
                android:max="100"/>

            <Switch
                android:id="@+id/swMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Monitor (earpiece)"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:thumbTint="#00E676"
                android:trackTint="#444444"/>
        </LinearLayout>

        <!-- ── Gain ───────────────────────────────────────────────────── -->
        <LinearLayout style="@style/CardBox" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView style="@style/SectionTitle" android:text="GAIN" android:layout_weight="1" android:layout_width="0dp"/>
                <TextView android:id="@+id/tvGain" style="@style/ValueLabel" android:text="0 dB"/>
            </LinearLayout>
            <SeekBar android:id="@+id/sbGain" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:progressTint="#00E676" android:thumbTint="#00E676"/>
        </LinearLayout>

        <!-- ── 10-Band EQ ──────────────────────────────────────────────── -->
        <LinearLayout style="@style/CardBox" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView style="@style/SectionTitle" android:text="10-BAND EQ"
                    android:layout_width="0dp" android:layout_weight="1"/>
                <Button android:id="@+id/btnEqReset"
                    style="@style/MiniBtn" android:text="Reset"/>
            </LinearLayout>

            <!-- Preset buttons -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnPresetFlat"  style="@style/PresetBtn" android:text="Flat"/>
                <Button android:id="@+id/btnPresetBass"  style="@style/PresetBtn" android:text="Bass"/>
                <Button android:id="@+id/btnPresetVoice" style="@style/PresetBtn" android:text="Voice"/>
                <Button android:id="@+id/btnPresetAir"   style="@style/PresetBtn" android:text="Air"/>
            </LinearLayout>

            <!-- EQ sliders in horizontal scroll -->
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq0" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#FF6B35" android:thumbTint="#FF6B35"/>
                        <TextView android:id="@+id/tvEq0" style="@style/EqLabel" android:text="0\n31Hz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq1" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#FF9A3C" android:thumbTint="#FF9A3C"/>
                        <TextView android:id="@+id/tvEq1" style="@style/EqLabel" android:text="0\n63Hz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq2" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#FFC857" android:thumbTint="#FFC857"/>
                        <TextView android:id="@+id/tvEq2" style="@style/EqLabel" android:text="0\n125Hz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq3" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#A8E063" android:thumbTint="#A8E063"/>
                        <TextView android:id="@+id/tvEq3" style="@style/EqLabel" android:text="0\n250Hz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq4" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#56C596" android:thumbTint="#56C596"/>
                        <TextView android:id="@+id/tvEq4" style="@style/EqLabel" android:text="0\n500Hz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq5" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#00E676" android:thumbTint="#00E676"/>
                        <TextView android:id="@+id/tvEq5" style="@style/EqLabel" android:text="0\n1kHz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq6" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#29B6F6" android:thumbTint="#29B6F6"/>
                        <TextView android:id="@+id/tvEq6" style="@style/EqLabel" android:text="0\n2kHz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq7" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#7C4DFF" android:thumbTint="#7C4DFF"/>
                        <TextView android:id="@+id/tvEq7" style="@style/EqLabel" android:text="0\n4kHz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq8" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#E040FB" android:thumbTint="#E040FB"/>
                        <TextView android:id="@+id/tvEq8" style="@style/EqLabel" android:text="0\n8kHz"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="40dp" android:layout_height="200dp" android:orientation="vertical" android:gravity="center">
                        <SeekBar android:id="@+id/sbEq9" android:layout_width="200dp" android:layout_height="wrap_content"
                            android:rotation="270" android:progressTint="#F06292" android:thumbTint="#F06292"/>
                        <TextView android:id="@+id/tvEq9" style="@style/EqLabel" android:text="0\n16kHz"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ── Echo ───────────────────────────────────────────────────── -->
        <LinearLayout style="@style/CardBox" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:text="ECHO" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Delay"/>
                <SeekBar android:id="@+id/sbEchoDelay" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00E676" android:thumbTint="#00E676"/>
                <TextView android:id="@+id/tvEchoDelay" style="@style/ValueLabel" android:text="300 ms"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Feedback"/>
                <SeekBar android:id="@+id/sbEchoFeedback" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00E676" android:thumbTint="#00E676"/>
                <TextView android:id="@+id/tvEchoFeedback" style="@style/ValueLabel" android:text="0.40"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Mix"/>
                <SeekBar android:id="@+id/sbEchoMix" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00E676" android:thumbTint="#00E676"/>
                <TextView android:id="@+id/tvEchoMix" style="@style/ValueLabel" android:text="0%"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Reverb ─────────────────────────────────────────────────── -->
        <LinearLayout style="@style/CardBox" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:text="REVERB" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Room Size"/>
                <SeekBar android:id="@+id/sbRevRoom" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00C853" android:thumbTint="#00C853"/>
                <TextView android:id="@+id/tvRevRoom" style="@style/ValueLabel" android:text="50%"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Damping"/>
                <SeekBar android:id="@+id/sbRevDamp" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00C853" android:thumbTint="#00C853"/>
                <TextView android:id="@+id/tvRevDamp" style="@style/ValueLabel" android:text="50%"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Mix"/>
                <SeekBar android:id="@+id/sbRevMix" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00C853" android:thumbTint="#00C853"/>
                <TextView android:id="@+id/tvRevMix" style="@style/ValueLabel" android:text="0%"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Noise Gate ─────────────────────────────────────────────── -->
        <LinearLayout style="@style/CardBox" android:orientation="vertical">
            <TextView style="@style/SectionTitle" android:text="NOISE GATE" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Threshold"/>
                <SeekBar android:id="@+id/sbNoiseGate" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00E676" android:thumbTint="#00E676"/>
                <TextView android:id="@+id/tvNoiseGate" style="@style/ValueLabel" android:text="-20 dB"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Compressor ─────────────────────────────────────────────── -->
        <LinearLayout style="@style/CardBox" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView style="@style/SectionTitle" android:text="COMPRESSOR"
                    android:layout_width="0dp" android:layout_weight="1"/>
                <Switch android:id="@+id/swComp" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:thumbTint="#00E676" android:trackTint="#444444"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Threshold"/>
                <SeekBar android:id="@+id/sbCompThresh" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00E676" android:thumbTint="#00E676"/>
                <TextView android:id="@+id/tvCompThresh" style="@style/ValueLabel" android:text="-20 dB"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Ratio"/>
                <SeekBar android:id="@+id/sbCompRatio" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00E676" android:thumbTint="#00E676"/>
                <TextView android:id="@+id/tvCompRatio" style="@style/ValueLabel" android:text="4.0:1"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/ParamLabel" android:text="Makeup"/>
                <SeekBar android:id="@+id/sbCompMakeup" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:progressTint="#00E676" android:thumbTint="#00E676"/>
                <TextView android:id="@+id/tvCompMakeup" style="@style/ValueLabel" android:text="0.0 dB"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Để dùng với Discord: bật Monitor → chọn Speaker trong Discord"
            android:textColor="#555555"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
