<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MicEQ" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">#00E676</item>
        <item name="colorPrimaryVariant">#00C853</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSurface">#141414</item>
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CardBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#00E676</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <style name="ParamLabel">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#666666</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ValueLabel">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">end</item>
    </style>

    <style name="EqLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#555555</item>
        <item name="android:textSize">9sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="MiniBtn" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="strokeColor">#333333</item>
        <item name="android:textColor">#666666</item>
    </style>

    <style name="PresetBtn" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="strokeColor">#1A1A1A</item>
        <item name="android:textColor">#00E676</item>
        <item name="rippleColor">#00E676</item>
        <item name="backgroundTint">#0D0D0D</item>
    </style>

</resources>
